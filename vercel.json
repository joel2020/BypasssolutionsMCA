{
  "rewrites": [
    {
      "source": "/((?!assets/|application-reader/|favicon.ico|favicon.svg|robots.txt|sitemap.xml|manifest.webmanifest).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/apply",
      "permanent": false,
      "has": [
        {
          "type": "host",
          "value": "apply.bypasssolution.com"
        }
      ]
    },
    {
      "source": "/",
      "destination": "/admin",
      "permanent": false,
      "has": [
        {
          "type": "host",
          "value": "crm.bypasssolution.com"
        }
      ]
    }
  ],
  "functions": {
    "api/generate-application.ts": {
      "includeFiles": "node_modules/{pdfjs-dist,@napi-rs/canvas*}/**",
      "maxDuration": 60
    }
  }
}
