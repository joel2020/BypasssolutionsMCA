# Server-only secrets for Supabase Edge Functions / deployment jobs.
# Never prefix these with VITE_ and never import them into client code.
SUPABASE_SERVICE_ROLE_KEY=

EMAIL_PROVIDER=resend
EMAIL_FROM=Elite Funding Solutions <info@elitefundingsolution.com>
LENDER_EMAIL_FROM=Elite Funding Solutions <submissions@elitefundingsolution.com>
EMAIL_PROVIDER_API_KEY=
RESEND_API_KEY=
INTERNAL_APPLICATION_ALERT_EMAIL=funding@elitefundingsolution.com
APPLICATION_FIELD_ENCRYPTION_KEY=

DATAMERCH_API_KEY=
CREDIT_PROVIDER_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Vercel /api/start-application (lean lead-capture + signNow) ---
# These must be set in Vercel → Settings → Environment Variables (NOT Supabase),
# because /api/start-application runs as a Vercel serverless function.
# Lead capture needs:
SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY (above) is also required here.
# signNow (the app is auto-generated + emailed for e-signature):
SIGNNOW_API_KEY=
SIGNNOW_TEMPLATE_ID=
SIGNNOW_API_BASE=https://api.signnow.com
# Optional OAuth password-grant alternative to SIGNNOW_API_KEY:
SIGNNOW_CLIENT_BASIC=
SIGNNOW_USERNAME=
SIGNNOW_PASSWORD=
# Optional invite tuning:
SIGNNOW_SIGNER_ROLE=
SIGNNOW_FROM_EMAIL=
# Map signNow template field names -> lead keys to prefill, e.g.
# SIGNNOW_FIELD_MAP={"business_name":"legalName","amount":"requestedAmount","email":"email"}
SIGNNOW_FIELD_MAP=
