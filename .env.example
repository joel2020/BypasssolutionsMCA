# Bypass Solution public SPA
VITE_APP_URL=https://bypasssolution.com
VITE_ADMIN_URL=https://bypasssolution.com/admin

# Supabase client keys (anon key is safe for the browser when RLS is enabled)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only secrets for Supabase Edge Functions / deployment jobs. Never prefix with VITE_ and never import into client code.
SUPABASE_SERVICE_ROLE_KEY=

# Email provider for future Edge Function delivery of queued communication records
EMAIL_PROVIDER=resend
EMAIL_FROM=Bypass Solution <info@bypasssolution.com>
EMAIL_PROVIDER_API_KEY=
INTERNAL_APPLICATION_ALERT_EMAIL=funding@bypasssolution.com

# Future integrations — server-side only
DATAMERCH_API_KEY=
CREDIT_PROVIDER_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
